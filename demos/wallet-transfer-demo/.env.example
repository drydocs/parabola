# Optional: override the default Arc testnet RPC used by the demo's viem transport.
# Not required, falls back to ARC_TESTNET.rpcUrl from the SDK if unset.
# Vite only exposes env vars prefixed with VITE_ to client code (unlike the repo root's
# plain-name .env.example convention, which is a Node/dotenv convention that doesn't apply here).
VITE_ARC_RPC_URL=
